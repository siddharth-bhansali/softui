        <tr><td><code>--sui-space-5</code></td><td>48px (<code>sui-*-5</code>)</td></tr>
        <tr><td><code>--sui-space-6</code></td><td>64px (<code>sui-*-6</code>)</td></tr>
        <tr><td><code>--sui-space-7</code></td><td>96px (<code>sui-*-7</code>)</td></tr>
        <tr><td><code>sui-p-*</code>, <code>sui-m-*</code></td><td>All sides.</td></tr>
        <tr><td><code>sui-px-*</code>, <code>sui-mx-*</code></td><td>Inline axis (left and right).</td></tr>
        <tr><td><code>sui-py-*</code>, <code>sui-my-*</code></td><td>Block axis (top and bottom).</td></tr>
        <tr><td><code>sui-pt-*</code>, <code>sui-pb-*</code>, <code>sui-mt-*</code>, <code>sui-mb-*</code></td><td>Top / bottom.</td></tr>
        <tr><td><code>sui-ps-*</code>, <code>sui-pe-*</code>, <code>sui-ms-*</code>, <code>sui-me-*</code></td><td>Inline start / end: flip in RTL.</td></tr>
        <tr><td><code>sui-ml-*</code>, <code>sui-mr-*</code></td><td>Aliases of <code>ms</code> / <code>me</code>; also flip in RTL.</td></tr>
