</div>

<!-- Spacing Tokens -->
<div class="pg-section" id="section-4">
  <h3 class="pg-section-title">Spacing Tokens</h3>
  <p class="pg-section-desc">The scale lives in <code>--sui-space-0</code> to <code>--sui-space-7</code>. Override a token to retune every padding, margin and gap utility at that step, either globally with <code>:root { --sui-space-3: 20px; }</code> or on a single subtree.</p>
  <div class="pg-section-row">
    <div class="docs-table-wrap" style="width:100%;">
      <table class="sui-table">
        <thead>
          <tr><th scope="col">Token</th><th scope="col">Value</th><th scope="col">Classes</th></tr>
        </thead>
        <tbody>
          <tr><td><code>--sui-space-0</code></td><td>0</td><td><code>sui-*-0</code></td></tr>
          <tr><td><code>--sui-space-1</code></td><td>4px</td><td><code>sui-*-1</code></td></tr>
          <tr><td><code>--sui-space-2</code></td><td>8px</td><td><code>sui-*-2</code></td></tr>
          <tr><td><code>--sui-space-3</code></td><td>16px</td><td><code>sui-*-3</code></td></tr>
          <tr><td><code>--sui-space-4</code></td><td>24px</td><td><code>sui-*-4</code></td></tr>
          <tr><td><code>--sui-space-5</code></td><td>48px</td><td><code>sui-*-5</code></td></tr>
          <tr><td><code>--sui-space-6</code></td><td>64px</td><td><code>sui-*-6</code></td></tr>
          <tr><td><code>--sui-space-7</code></td><td>96px</td><td><code>sui-*-7</code></td></tr>
        </tbody>
      </table>
    </div>
  </div>
  <div class="pg-section-row">
