<!-- Padding Directions -->
<div class="pg-section" id="section-2">
  <h3 class="pg-section-title">Padding Directions</h3>
  <p class="pg-section-desc">Classes: <code>sui-p-{0-7}</code> (all sides), <code>sui-px-{0-7}</code> (inline axis), <code>sui-py-{0-7}</code> (block axis), <code>sui-pt-{0-7}</code>, <code>sui-pb-{0-7}</code>, <code>sui-ps-{0-7}</code> (inline-start) and <code>sui-pe-{0-7}</code> (inline-end). Start and end are logical: <code>ps</code> is the left side in LTR and the right side in RTL. Classes combine from general to specific, so <code>sui-p-1 sui-ps-5</code> gives 4px everywhere except 48px at the start.</p>
  <div class="pg-section-row">
    <div style="display:flex;flex-direction:column;gap:12px;width:100%;">
      <div class="sui-raised sui-px-5 sui-py-2" style="border-radius:12px;">
        <div style="background:color-mix(in srgb, var(--sui-primary) 15%, transparent);border-radius:6px;padding:6px 10px;">sui-px-5 sui-py-2</div>
      </div>
      <div class="sui-raised sui-p-1 sui-pt-5" style="border-radius:12px;">
        <div style="background:color-mix(in srgb, var(--sui-primary) 15%, transparent);border-radius:6px;padding:6px 10px;">sui-p-1 sui-pt-5</div>
      </div>
      <div class="sui-raised sui-p-1 sui-ps-5" style="border-radius:12px;">
        <div style="background:color-mix(in srgb, var(--sui-primary) 15%, transparent);border-radius:6px;padding:6px 10px;">sui-p-1 sui-ps-5 (inline-start: left in LTR, right in RTL)</div>
      </div>
      <div class="sui-raised sui-p-1 sui-pe-5" style="border-radius:12px;">
        <div style="background:color-mix(in srgb, var(--sui-primary) 15%, transparent);border-radius:6px;padding:6px 10px;">sui-p-1 sui-pe-5 (inline-end: right in LTR, left in RTL)</div>
      </div>
    </div>
  </div>
  <div class="pg-code-wrap">
    <button class="pg-code-toggle" onclick="toggleGalleryCode(this)"><span class="chevron">&#9654;</span> Show Code</button>
    <div class="pg-code-block"><button class="pg-code-copy" onclick="copyPgCode(this)">Copy</button><pre>&lt;div class="sui-px-5 sui-py-2"&gt;Padding inline 48px, block 8px&lt;/div&gt;
&lt;div class="sui-p-1 sui-pt-5"&gt;Padding 4px, top 48px&lt;/div&gt;
&lt;div class="sui-p-1 sui-ps-5"&gt;Padding 4px, inline-start 48px (left in LTR, right in RTL)&lt;/div&gt;
&lt;div class="sui-p-1 sui-pe-5"&gt;Padding 4px, inline-end 48px (right in LTR, left in RTL)&lt;/div&gt;</pre></div>
  </div>
</div>

<!-- Margin Directions -->
<div class="pg-section" id="section-3">
  <h3 class="pg-section-title">Margin Directions</h3>
  <p class="pg-section-desc">Classes: <code>sui-m-{0-7}</code>, <code>sui-mx-{0-7}</code>, <code>sui-my-{0-7}</code>, <code>sui-mt-{0-7}</code>, <code>sui-mb-{0-7}</code>, <code>sui-ms-{0-7}</code> (inline-start) and <code>sui-me-{0-7}</code> (inline-end), plus <code>sui-mx-auto</code>, <code>sui-my-auto</code>, <code>sui-ms-auto</code> and <code>sui-me-auto</code>. <code>sui-ml-{0-7}</code> and <code>sui-mr-{0-7}</code> are kept as aliases of <code>ms</code> and <code>me</code>, so they also flip in RTL.</p>
  <div class="pg-section-row">
    <div style="display:flex;flex-direction:column;gap:12px;width:100%;">
      <div class="sui-inset" style="border-radius:12px;display:flow-root;">
        <div class="sui-raised sui-mx-5 sui-my-2" style="border-radius:8px;padding:6px 10px;">sui-mx-5 sui-my-2</div>
      </div>
      <div class="sui-inset" style="border-radius:12px;display:flow-root;">
        <div class="sui-raised sui-my-2 sui-ms-5" style="border-radius:8px;padding:6px 10px;">sui-my-2 sui-ms-5 (inline-start)</div>
      </div>
      <div class="sui-inset" style="border-radius:12px;display:flow-root;">
        <div class="sui-raised sui-my-2 sui-me-5" style="border-radius:8px;padding:6px 10px;">sui-my-2 sui-me-5 (inline-end)</div>
      </div>
      <div class="sui-inset" style="border-radius:12px;display:flow-root;">
        <div class="sui-raised sui-mt-4 sui-mb-1 sui-mx-2" style="border-radius:8px;padding:6px 10px;">sui-mt-4 sui-mb-1 sui-mx-2</div>
      </div>
    </div>
  </div>
  <div class="pg-code-wrap">
    <button class="pg-code-toggle" onclick="toggleGalleryCode(this)"><span class="chevron">&#9654;</span> Show Code</button>
    <div class="pg-code-block"><button class="pg-code-copy" onclick="copyPgCode(this)">Copy</button><pre>&lt;div class="sui-mx-5 sui-my-2"&gt;Margin inline 48px, block 8px&lt;/div&gt;
&lt;div class="sui-my-2 sui-ms-5"&gt;Margin inline-start 48px (left in LTR, right in RTL)&lt;/div&gt;
&lt;div class="sui-my-2 sui-me-5"&gt;Margin inline-end 48px (right in LTR, left in RTL)&lt;/div&gt;
&lt;div class="sui-mt-4 sui-mb-1 sui-mx-2"&gt;Margin top 24px, bottom 4px, inline 8px&lt;/div&gt;</pre></div>
