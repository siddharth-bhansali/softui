<!-- Font Family & Numerals -->
<div class="pg-section" id="section-3">
  <h3 class="pg-section-title">Font Family & Numerals</h3>
  <p class="pg-section-desc"><code>sui-font-sans</code> and <code>sui-font-mono</code> switch to the <code>--sui-font</code> and <code>--sui-font-mono</code> stacks, and override a component's own font. <code>sui-tabular-nums</code> gives every digit the same width so columns of numbers line up; <code>sui-proportional-nums</code> switches back.</p>
  <div class="pg-section-row">
    <div style="display:flex;flex-direction:column;gap:8px;">
      <span class="sui-font-sans">sui-font-sans — Plus Jakarta Sans</span>
      <span class="sui-font-mono">sui-font-mono — const x = 42;</span>
    </div>
  </div>
  <div class="pg-section-row">
    <div style="display:flex;gap:16px;flex-wrap:wrap;">
      <div class="sui-raised sui-text-right" style="border-radius:12px;padding:16px;min-width:140px;">
        <small class="sui-text-muted">Default</small>
        <div>1,111.11</div>
        <div>8,888.88</div>
        <div>4,701.10</div>
      </div>
      <div class="sui-raised sui-text-right sui-tabular-nums" style="border-radius:12px;padding:16px;min-width:140px;">
        <small class="sui-text-muted">sui-tabular-nums</small>
        <div>1,111.11</div>
        <div>8,888.88</div>
        <div>4,701.10</div>
      </div>
    </div>
  </div>
  <div class="pg-code-wrap">
    <button class="pg-code-toggle" onclick="toggleGalleryCode(this)"><span class="chevron">&#9654;</span> Show Code</button>
    <div class="pg-code-block"><button class="pg-code-copy" onclick="copyPgCode(this)">Copy</button><pre>&lt;span class="sui-font-sans"&gt;sui-font-sans — Plus Jakarta Sans&lt;/span&gt;
&lt;span class="sui-font-mono"&gt;sui-font-mono — const x = 42;&lt;/span&gt;

&lt;!-- Default (proportional) digits --&gt;
&lt;div class="sui-text-right"&gt;
  &lt;div&gt;1,111.11&lt;/div&gt;
  &lt;div&gt;8,888.88&lt;/div&gt;
  &lt;div&gt;4,701.10&lt;/div&gt;
&lt;/div&gt;

&lt;!-- Equal-width digits that line up --&gt;
&lt;div class="sui-text-right sui-tabular-nums"&gt;
  &lt;div&gt;1,111.11&lt;/div&gt;
  &lt;div&gt;8,888.88&lt;/div&gt;
  &lt;div&gt;4,701.10&lt;/div&gt;
&lt;/div&gt;</pre></div>
  </div>
</div>
