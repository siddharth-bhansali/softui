  <p style="font-size:13px;color:var(--sui-text-light);margin-bottom:16px;">Add <code>.sui-flat-all</code> to a container to flatten everything inside it, including toggle knobs and slider thumbs.</p>
  <div class="sui-flat-all" data-theme="light" style="color:var(--sui-text);display:flex;gap:20px;flex-wrap:wrap;align-items:center;background:#fff;padding:24px;border-radius:var(--sui-radius);">
    <div class="sui-card" style="padding:16px 20px;">Card</div>
    <label class="sui-toggle"><input type="checkbox" checked aria-label="Notifications"><span class="sui-toggle-slider"></span></label>
    <label class="sui-toggle"><input type="checkbox" aria-label="Dark mode"><span class="sui-toggle-slider"></span></label>
    <input type="range" class="sui-range" aria-label="Volume" style="max-width:160px;">
    <button class="sui-btn">Button</button>
    <button class="sui-btn sui-btn-primary">Primary</button>
  </div>
  <div class="pg-code-wrap">
    <button class="pg-code-toggle" onclick="toggleGalleryCode(this)"><span class="chevron">&#9654;</span> Show Code</button>
    <div class="pg-code-block"><button class="pg-code-copy" onclick="copyPgCode(this)">Copy</button><pre>&lt;div class="sui-flat-all" data-theme="light" style="color:var(--sui-text);display:flex;gap:20px;flex-wrap:wrap;align-items:center;background:#fff;padding:24px;border-radius:var(--sui-radius);"&gt;
  &lt;div class="sui-card" style="padding:16px 20px;"&gt;Card&lt;/div&gt;
  &lt;label class="sui-toggle"&gt;&lt;input type="checkbox" checked aria-label="Notifications"&gt;&lt;span class="sui-toggle-slider"&gt;&lt;/span&gt;&lt;/label&gt;
  &lt;label class="sui-toggle"&gt;&lt;input type="checkbox" aria-label="Dark mode"&gt;&lt;span class="sui-toggle-slider"&gt;&lt;/span&gt;&lt;/label&gt;
  &lt;input type="range" class="sui-range" aria-label="Volume" style="max-width:160px;"&gt;
