<!-- Reference -->
<div class="pg-section" id="section-4">
  <h3 class="pg-section-title">Reference</h3>
  <div class="docs-table-wrap">
    <table class="sui-table sui-table-compact">
      <thead>
        <tr><th scope="col" style="width:40%;">Class / Token</th><th scope="col">Description</th></tr>
      </thead>
      <tbody>
        <tr><td><code>.sui-flat</code></td><td>Removes the element's own shadow, also on hover, and adds a subtle border.</td></tr>
        <tr><td><code>.sui-flat-all</code></td><td>Swaps every neumorphic shadow inside for a hairline <code>--sui-bg-dark</code> outline. Coloured glows, menu and modal shadows, and focus rings are kept.</td></tr>
        <tr><td>Stronger outline</td><td>The hairline is under WCAG's 3:1. On the container, set <code>--sui-shadow-raised</code>, <code>-raised-sm</code>, <code>-raised-lg</code> to <code>0 0 0 1px var(--sui-text-light)</code> and <code>--sui-shadow-inset</code>, <code>-inset-sm</code> to <code>inset 0 0 0 1px var(--sui-text-light)</code>.</td></tr>
        <tr><td><code>.sui-surface</code> + <code>data-theme="dark"</code></td><td>On a page darker than <code>--sui-bg</code>, gives the area the matching background so dark shadows don't show a light halo.</td></tr>
      </tbody>
    </table>
  </div>
</div>
