<!-- JavaScript API -->
<div class="pg-section" id="section-4">
  <h3 class="pg-section-title">JavaScript API</h3>
  <p class="pg-section-desc"><code>.sui-reveal</code> elements in the page are picked up on load, and by <code>SoftUI.init(el)</code>. For content you add later, call <code>SoftUI.reveal()</code> with a selector, an element or a list. Add <code>data-reveal-repeat</code> to hide the element again when it leaves the viewport and replay it on the way back.</p>
  <div class="pg-section-row" style="flex-direction:column;align-items:flex-start;gap:16px;">
    <button class="sui-btn sui-btn-primary" onclick="addCard()">Add a card</button>
    <div id="revealList" style="display:flex;flex-direction:column;gap:12px;max-width:360px;"></div>
  </div>
  <div class="pg-code-wrap">
    <button class="pg-code-toggle" onclick="toggleGalleryCode(this)"><span class="chevron">&#9654;</span> Show Code</button>
    <div class="pg-code-block"><button class="pg-code-copy" onclick="copyPgCode(this)">Copy</button><pre>&lt;button class="sui-btn sui-btn-primary" onclick="addCard()"&gt;Add a card&lt;/button&gt;
&lt;div id="revealList" style="display:flex;flex-direction:column;gap:12px;max-width:360px;"&gt;&lt;/div&gt;

&lt;script&gt;
  function addCard() {
    var card = document.createElement('div');
    card.className = 'sui-card sui-reveal sui-reveal-scale';
    card.style.padding = '16px 20px';
    card.textContent = 'Added at ' + new Date().toLocaleTimeString();
    document.getElementById('revealList').appendChild(card);
    SoftUI.reveal(card);
  }

  // Other forms
  SoftUI.reveal();                    // every .sui-reveal not yet revealed
  SoftUI.reveal('.feature-card');     // a selector (adds .sui-reveal if missing)
  SoftUI.reveal(listOfElements);      // a NodeList or array

  // Observer options — read once, on the first call
  SoftUI.reveal('.feature-card', { rootMargin: '0px 0px -20% 0px', threshold: 0.2 });
&lt;/script&gt;

&lt;!-- Replay every time it scrolls back into view --&gt;
&lt;div class="sui-reveal" data-reveal-repeat&gt;...&lt;/div&gt;</pre></div>
  </div>
</div>

<!-- Accessibility -->
<div class="pg-section" id="section-5">
  <h3 class="pg-section-title">Accessibility</h3>
  <p class="pg-section-desc">Content is only hidden after <code>softui.js</code> adds <code>.sui-reveal-ready</code> to <code>&lt;html&gt;</code>, so it is always visible without JavaScript and when printing. Users who prefer reduced motion see everything immediately, with no delay. Reveal uses the <code>translate</code> and <code>scale</code> properties, so it doesn't fight a component's own <code>transform</code> — but it does set <code>opacity</code>, so put <code>.sui-reveal</code> on a wrapper around interactive components rather than on the component itself. <button class="sui-btn sui-btn-sm" onclick="replayReveal(this)">Replay</button></p>
  <div class="pg-section-row">
    <div class="sui-reveal sui-reveal-start" data-reveal-repeat style="max-width:360px;">
      <div class="sui-card sui-card-hover" style="padding:24px;">
        <h4 style="margin-bottom:8px;">Wrapped card</h4>
        <p style="color:var(--sui-text-muted);font-size:14px;">The wrapper reveals; the card keeps its hover lift. Scroll away and back to replay.</p>
      </div>
    </div>
  </div>
  <div class="pg-code-wrap">
    <button class="pg-code-toggle" onclick="toggleGalleryCode(this)"><span class="chevron">&#9654;</span> Show Code</button>
    <div class="pg-code-block"><button class="pg-code-copy" onclick="copyPgCode(this)">Copy</button><pre>&lt;!-- Reveal the wrapper, not the interactive card --&gt;
&lt;div class="sui-reveal sui-reveal-start" data-reveal-repeat style="max-width:360px;"&gt;
  &lt;div class="sui-card sui-card-hover" style="padding:24px;"&gt;
    &lt;h4 style="margin-bottom:8px;"&gt;Wrapped card&lt;/h4&gt;
    &lt;p style="color:var(--sui-text-muted);font-size:14px;"&gt;The wrapper reveals; the card keeps its hover lift. Scroll away and back to replay.&lt;/p&gt;
  &lt;/div&gt;
&lt;/div&gt;

&lt;!-- No JS or prefers-reduced-motion: content is simply visible --&gt;</pre></div>
  </div>
</div>
