<script>
  // Docs only: replay the reveal animation of a demo
  function replayReveal(btn) {
    var row = btn.closest('.pg-section').querySelector('.pg-section-row');
    var els = row.querySelectorAll('.sui-reveal');
    els.forEach(function(el) { el.classList.remove('sui-revealed', 'sui-reveal-done'); });
    SoftUI.reveal(els);
  }

  // JavaScript API demo
  function addCard() {
    var card = document.createElement('div');
    card.className = 'sui-card sui-reveal sui-reveal-scale';
    card.style.padding = '16px 20px';
    card.textContent = 'Added at ' + new Date().toLocaleTimeString();
    document.getElementById('revealList').appendChild(card);
    SoftUI.reveal(card);
  }
</script>

