  <p style="font-size:13px;color:var(--sui-text-light);margin-bottom:16px;">Constrain dates with <code>data-sui-min</code> / <code>data-sui-max</code>.</p>
  <div class="pg-section-row" style="justify-content:center;">
    <div class="sui-calendar" data-sui-calendar="single" data-sui-min="today" data-sui-max="2030-12-31">
