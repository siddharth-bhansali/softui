<!-- Time Picker -->
<div class="pg-section" id="section-8">
  <h3 class="pg-section-title">Time Picker</h3>
  <p style="font-size:13px;color:var(--sui-text-light);margin-bottom:16px;">A standalone time picker without a calendar.</p>
  <div class="pg-section-row" style="justify-content:center;gap:24px;flex-wrap:wrap;">
    <div>
      <p style="font-size:12px;color:var(--sui-text-muted);margin-bottom:8px;text-align:center;">12-hour</p>
      <div class="sui-timepicker" data-sui-timepicker></div>
    </div>
    <div>
      <p style="font-size:12px;color:var(--sui-text-muted);margin-bottom:8px;text-align:center;">24-hour</p>
      <div class="sui-timepicker" data-sui-timepicker="24h"></div>
    </div>
  </div>
  <div class="pg-code-wrap">
    <button class="pg-code-toggle" onclick="toggleGalleryCode(this)"><span class="chevron">&#9654;</span> Show Code</button>
    <div class="pg-code-block"><button class="pg-code-copy" onclick="copyPgCode(this)">Copy</button><pre>&lt;!-- 12-hour time picker --&gt;
&lt;div class="sui-timepicker" data-sui-timepicker&gt;&lt;/div&gt;

&lt;!-- 24-hour time picker --&gt;
&lt;div class="sui-timepicker" data-sui-timepicker="24h"&gt;&lt;/div&gt;

&lt;!-- Listen for changes --&gt;
&lt;script&gt;
  document.querySelector('.sui-timepicker').addEventListener('sui-time-change', function(e) {
    console.log(e.detail); // { hour: 2, minute: 30, period: 'PM', is24h: false }
  });
&lt;/script&gt;</pre></div>
