<!-- Reference -->
<div class="pg-section" id="section-9">
  <h3 class="pg-section-title">Reference</h3>
  <div class="docs-table-wrap">
    <table class="sui-table sui-table-compact">
      <thead>
        <tr><th scope="col" style="width:40%;">Attribute / Event</th><th scope="col">Description</th></tr>
      </thead>
      <tbody>
        <tr><td><code>data-sui-calendar="single|range"</code></td><td>Turns the element into a calendar. Click the title to drill into month and year views.</td></tr>
        <tr><td><code>data-sui-calendar-time</code></td><td>Adds hour and minute inputs (12-hour with AM/PM; <code>"24h"</code> for 24-hour). Arrow keys step the values, and a popover stays open after picking a date.</td></tr>
        <tr><td><code>data-sui-min</code> / <code>data-sui-max</code></td><td><code>"today"</code> or a <code>YYYY-MM-DD</code> date. Dates outside the range are disabled.</td></tr>
        <tr><td><code>data-sui-disabled</code></td><td>Comma-separated <code>YYYY-MM-DD</code> dates to disable.</td></tr>
        <tr><td><code>sui-datepicker</code></td><td>Wraps a trigger and a popover calendar. Picking a date (or a full range) closes the popover and fills the trigger.</td></tr>
        <tr><td><code>data-sui-timepicker</code></td><td>Standalone time picker (12-hour; <code>"24h"</code> for 24-hour). Arrow keys step the values.</td></tr>
        <tr><td><code>sui-date-select</code></td><td>Fires on the calendar with <code>detail.date</code> (plus <code>hour</code>, <code>minute</code>, <code>period</code>, <code>is24h</code> when time is on), or <code>detail.start</code> / <code>end</code> in range mode.</td></tr>
        <tr><td><code>sui-date-clear</code></td><td>Fires on the calendar when Clear is pressed.</td></tr>
        <tr><td><code>sui-time-change</code></td><td>Fires on change with <code>detail.hour</code>, <code>minute</code>, <code>period</code>, <code>is24h</code>; bubbles.</td></tr>
      </tbody>
    </table>
  </div>
</div>
