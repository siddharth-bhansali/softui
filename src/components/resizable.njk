<!-- Reference -->
<div class="pg-section" id="section-7">
  <h3 class="pg-section-title">Reference</h3>
  <div class="docs-table-wrap">
    <table class="sui-table sui-table-compact">
      <thead>
        <tr><th scope="col" style="width:40%;">Class / Attribute / Key</th><th scope="col">Description</th></tr>
      </thead>
      <tbody>
        <tr><td><code>data-size</code></td><td>Starting share of the panel (a flex-grow value). Panels without it split the space equally.</td></tr>
        <tr><td><code>data-min-size</code></td><td>Smallest share the panel can be dragged to.</td></tr>
        <tr><td><code>sui-resizable-vertical</code></td><td>Stacks panels vertically with horizontal handles.</td></tr>
        <tr><td><code>sui-resizable-handle-visible</code></td><td>Shows a grip on the handle.</td></tr>
        <tr><td><code>sui-resizable-borderless</code></td><td>Removes the shadow and radius, for a resizable nested inside a panel.</td></tr>
        <tr><td><code>sui-resizable-panel</code></td><td>Has no padding, so add your own.</td></tr>
        <tr><td><kbd class="sui-kbd-inline">&larr;</kbd> / <kbd class="sui-kbd-inline">&rarr;</kbd></td><td>On a focused handle, resize by 2 (<kbd class="sui-kbd-inline">&uarr;</kbd> / <kbd class="sui-kbd-inline">&darr;</kbd> in the vertical variant).</td></tr>
        <tr><td><kbd class="sui-kbd-inline">Shift</kbd> + Arrow</td><td>Resize by 10.</td></tr>
        <tr><td><kbd class="sui-kbd-inline">Home</kbd> / <kbd class="sui-kbd-inline">End</kbd></td><td>Collapse the panel before / after the handle as far as its minimum allows.</td></tr>
      </tbody>
    </table>
  </div>
</div>
