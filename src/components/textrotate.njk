<!-- Reference -->
<div class="pg-section" id="section-8">
  <h3 class="pg-section-title">Reference</h3>
  <div class="docs-table-wrap">
    <table class="sui-table sui-table-compact">
      <thead>
        <tr><th scope="col" style="width:40%;">Attribute / Setting</th><th scope="col">Description</th></tr>
      </thead>
      <tbody>
        <tr><td><code>data-interval</code></td><td>Milliseconds between words (default 2000).</td></tr>
        <tr><td><code>data-reserve</code></td><td>Holds the width of the longest word so the text after it does not move.</td></tr>
        <tr><td><code>data-sr-text</code></td><td>What screen readers hear (default: the words once, as a list).</td></tr>
        <tr><td><code>prefers-reduced-motion</code></td><td>The first word stays put.</td></tr>
      </tbody>
    </table>
  </div>
</div>
