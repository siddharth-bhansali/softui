<div class="pg-section" id="section-7">
  <h3 class="pg-section-title">Reserve Space</h3>
  <p style="font-size:13px;color:var(--sui-text-light);margin-bottom:16px;">Add <code>data-reserve</code> to hold the width of the longest word.</p>
  <div class="pg-section-row">
