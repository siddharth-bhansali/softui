<!-- Reference -->
<div class="pg-section" id="section-3">
  <h3 class="pg-section-title">Reference</h3>
  <div class="docs-table-wrap">
    <table class="sui-table sui-table-compact">
      <thead>
        <tr><th scope="col" style="width:40%;">Option / Method</th><th scope="col">Description</th></tr>
      </thead>
      <tbody>
        <tr><td><code>SoftUI.tour(steps, options)</code></td><td>Starts a tour at the first step and returns a handle with the methods below. Clicking the backdrop closes the tour.</td></tr>
        <tr><td><code>step.target</code></td><td>CSS selector for the element to highlight.</td></tr>
        <tr><td><code>step.title</code></td><td>Step title text.</td></tr>
        <tr><td><code>step.description</code></td><td>Step description text.</td></tr>
        <tr><td><code>step.position</code></td><td>Tooltip side: <code>'top'</code>, <code>'bottom'</code>, <code>'left'</code> or <code>'right'</code>. Default <code>'bottom'</code>.</td></tr>
        <tr><td><code>step.html</code></td><td>Renders this step's title and description as HTML; overrides the tour's <code>html</code> option.</td></tr>
        <tr><td><code>padding</code></td><td>Spotlight padding around the target in px. Default <code>8</code>.</td></tr>
        <tr><td><code>noOverlay</code></td><td>Skips the dimmed backdrop. Default <code>false</code>.</td></tr>
        <tr><td><code>onComplete</code></td><td>Called when the tour closes (Done, Skip or backdrop click).</td></tr>
        <tr><td><code>html</code></td><td>Renders titles and descriptions as HTML. Default <code>false</code> (plain text). Trusted content only, never user input.</td></tr>
        <tr><td><code>.next()</code></td><td>Goes to the next step.</td></tr>
        <tr><td><code>.prev()</code></td><td>Goes to the previous step.</td></tr>
        <tr><td><code>.goTo(index)</code></td><td>Jumps to the step at <code>index</code> (zero-based).</td></tr>
        <tr><td><code>.close()</code></td><td>Ends the tour and calls <code>onComplete</code>.</td></tr>
      </tbody>
    </table>
  </div>
</div>
