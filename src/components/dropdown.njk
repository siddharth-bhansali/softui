<div class="pg-section" id="section-10">
  <h3 class="pg-section-title">Reference</h3>
  <div class="docs-table-wrap">
    <table class="sui-table sui-table-compact">
      <thead>
        <tr><th scope="col" style="width:40%;">Class / Attribute / Key</th><th scope="col">Description</th></tr>
      </thead>
      <tbody>
        <tr><td><code>data-sui-dropdown</code></td><td>Marks the toggle that opens and closes its menu; an outside click closes it.</td></tr>
        <tr><td><code>sui-dropup</code> / <code>sui-dropend</code> / <code>sui-dropstart</code></td><td>Opens the menu above, to the end side or to the start side.</td></tr>
        <tr><td><code>sui-dropdown-menu-end</code></td><td>Aligns the menu to the toggle's end edge.</td></tr>
        <tr><td><code>sui-dropdown-sm</code> / <code>sui-dropdown-lg</code></td><td>Smaller or larger menu items.</td></tr>
        <tr><td><code>sui-dropdown-no-arrow</code></td><td>Hides the toggle's caret (on <code>.sui-dropdown</code> or the toggle).</td></tr>
        <tr><td><code>sui-dropdown-header</code></td><td>Small uppercase group label inside the menu.</td></tr>
        <tr><td><code>sui-dropdown-divider</code></td><td>Line between item groups.</td></tr>
        <tr><td><code>sui-dropdown-text</code></td><td>Muted plain text inside the menu.</td></tr>
        <tr><td><code>active</code> / <code>disabled</code></td><td>Marks the current item, or dims an item and skips it in keyboard navigation.</td></tr>
        <tr><td><kbd class="sui-kbd-inline">&uarr;</kbd> / <kbd class="sui-kbd-inline">&darr;</kbd></td><td>Move focus through the open menu's items (wraps).</td></tr>
        <tr><td><kbd class="sui-kbd-inline">Esc</kbd></td><td>Close the menu; focus returns to the toggle.</td></tr>
      </tbody>
    </table>
  </div>
