<!-- Reference -->
<div class="pg-section" id="section-4">
  <h3 class="pg-section-title">Reference</h3>
  <div class="docs-table-wrap">
    <table class="sui-table sui-table-compact">
      <thead>
        <tr><th scope="col" style="width:40%;">Option / API</th><th scope="col">Description</th></tr>
      </thead>
      <tbody>
        <tr><td><code>SoftUI.toast(options)</code></td><td>Shows a toast and returns its element.</td></tr>
        <tr><td><code>title</code></td><td>Bold heading text.</td></tr>
        <tr><td><code>message</code></td><td>Body text.</td></tr>
        <tr><td><code>variant</code></td><td><code>'success'</code>, <code>'danger'</code>, <code>'warning'</code> or <code>'info'</code>. Default: none.</td></tr>
        <tr><td><code>duration</code></td><td>Milliseconds before it closes. Default <code>4000</code>; <code>0</code> keeps it open.</td></tr>
        <tr><td><code>position</code></td><td><code>'tr'</code>, <code>'tl'</code>, <code>'br'</code>, <code>'bl'</code>, <code>'tc'</code> or <code>'bc'</code>. Default <code>'tr'</code>.</td></tr>
        <tr><td><code>closable</code></td><td>Shows the close button. Default <code>true</code>.</td></tr>
        <tr><td><code>html</code></td><td>Renders title and message as HTML. Default <code>false</code> (plain text). Only pass trusted HTML, never user input.</td></tr>
      </tbody>
    </table>
  </div>
</div>
