<!-- Reference -->
<div class="pg-section" id="section-9">
  <h3 class="pg-section-title">Reference</h3>
  <div class="docs-table-wrap">
    <table class="sui-table sui-table-compact">
      <thead><tr><th scope="col">Class / Token</th><th scope="col">Description</th></tr></thead>
      <tbody>
        <tr><td style="white-space:nowrap;"><code>.sui-link</code></td><td>Underlined link for running text, so links are not marked by colour alone (WCAG 1.4.1).</td></tr>
        <tr><td style="white-space:nowrap;"><code>.sui-link-subtle</code> / <code>-muted</code></td><td>Inherited or muted text colour; standalone, no <code>.sui-link</code> needed.</td></tr>
        <tr><td style="white-space:nowrap;"><code>.sui-link-{color}</code></td><td>success, danger, warning or info; pairs with <code>.sui-link</code>, <code>-arrow</code> or <code>-raised</code>.</td></tr>
        <tr><td style="white-space:nowrap;"><code>.sui-link-hover</code></td><td>Underline on hover only; for nav lists, not prose.</td></tr>
        <tr><td style="white-space:nowrap;"><code>.sui-link-arrow</code></td><td>Trailing arrow that nudges on hover; points left in RTL.</td></tr>
        <tr><td style="white-space:nowrap;"><code>.sui-link-external</code></td><td>Trailing &#8599; glyph, hidden from screen readers; mirrored in RTL. Do not combine with <code>-arrow</code>.</td></tr>
        <tr><td style="white-space:nowrap;"><code>.sui-link-sm</code> / <code>-lg</code></td><td>13px / 18px text.</td></tr>
        <tr><td style="white-space:nowrap;"><code>.sui-link-raised</code></td><td>Pill link with raised depth, inset when pressed.</td></tr>
        <tr><td style="white-space:nowrap;"><code>--sui-link</code></td><td>Link colour. Default <code>var(--sui-primary-text)</code>, 4.5:1 in light and dark.</td></tr>
        <tr><td style="white-space:nowrap;"><code>--sui-link-hover</code></td><td>Hover colour. Default <code>var(--sui-primary-text-hover)</code>.</td></tr>
        <tr><td style="white-space:nowrap;"><code>--sui-link-underline</code></td><td>Resting underline colour. Default <code>currentColor</code> at 40%.</td></tr>
      </tbody>
    </table>
  </div>
</div>
