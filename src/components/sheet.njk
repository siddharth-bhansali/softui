    <div class="pg-code-block"><button class="pg-code-copy" onclick="copyPgCode(this)">Copy</button><pre>&lt;div class="sui-sheet-backdrop" id="mySheet" role="dialog" aria-modal="true" aria-label="Default Sheet"&gt;
  &lt;div class="sui-sheet sui-sheet-right"&gt;
    &lt;div class="sui-sheet-header"&gt;
