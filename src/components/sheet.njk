&lt;/div&gt;

&lt;script&gt;
  SoftUI.sheet('#mySheet').open();
  SoftUI.sheet('#mySheet').close();
  // Also accepts an element: SoftUI.sheet(document.getElementById('mySheet'))
  // Closing (Escape, backdrop, X, close()) returns focus to the opener.
&lt;/script&gt;
