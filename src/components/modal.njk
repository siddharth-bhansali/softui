<div class="pg-section" id="section-1">
  <h3 class="pg-section-title">Default Modal</h3>
  <div class="pg-section-row">
    <button class="sui-btn" onclick="SoftUI.modal('#demoModal').open()">Open Default Modal</button>
  </div>
  <div class="pg-code-wrap">
    <button class="pg-code-toggle" onclick="toggleGalleryCode(this)"><span class="chevron">&#9654;</span> Show Code</button>
    <div class="pg-code-block"><button class="pg-code-copy" onclick="copyPgCode(this)">Copy</button><pre>&lt;div class="sui-modal-backdrop" id="myModal" role="dialog" aria-modal="true" aria-labelledby="myModalTitle"&gt;
  &lt;div class="sui-modal"&gt;
    &lt;div class="sui-modal-header"&gt;
      &lt;h3 id="myModalTitle"&gt;Modal Title&lt;/h3&gt;
      &lt;button class="sui-modal-close" aria-label="Close"&gt;&lt;/button&gt;
    &lt;/div&gt;
    &lt;div class="sui-modal-body"&gt;
      &lt;p&gt;This is a neumorphic modal dialog. It features backdrop blur, smooth animations, and focus trap. Press Escape or click outside to close.&lt;/p&gt;
    &lt;/div&gt;
    &lt;div class="sui-modal-footer"&gt;
      &lt;button class="sui-btn sui-btn-sm" onclick="SoftUI.modal('#myModal').close()"&gt;Cancel&lt;/button&gt;
      &lt;button class="sui-btn sui-btn-primary sui-btn-sm"&gt;Confirm&lt;/button&gt;
    &lt;/div&gt;
  &lt;/div&gt;
&lt;/div&gt;

&lt;script&gt;
  // Open and close by selector or element
  SoftUI.modal('#myModal').open();
  SoftUI.modal('#myModal').close();
  // Escape, the backdrop, the X and close() all return focus to the
  // element that opened the modal. Escape closes the topmost modal/sheet.
&lt;/script&gt;</pre></div>
  </div>
</div>

