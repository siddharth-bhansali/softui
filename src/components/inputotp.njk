<!-- Reference -->
<div class="pg-section" id="section-9">
  <h3 class="pg-section-title">Reference</h3>
  <div class="docs-table-wrap">
    <table class="sui-table sui-table-compact">
      <thead>
        <tr><th scope="col" style="width:40%;">Attribute / Class / Event</th><th scope="col">Description</th></tr>
      </thead>
      <tbody>
        <tr><td><code>data-sui-otp</code></td><td>Turns <code>sui-otp</code> into a code input: click to focus, type or paste a code, and focus moves slot to slot. The slot count sets the code length.</td></tr>
        <tr><td><code>data-sui-otp-pattern</code></td><td><code>"digits"</code> (default) or <code>"alphanumeric"</code>. Alphanumeric input is uppercased.</td></tr>
        <tr><td><code>data-sui-otp-disabled</code></td><td>Renders the slots but does not accept input.</td></tr>
        <tr><td><code>sui-otp-complete</code></td><td>Fires on the <code>sui-otp</code> element when every slot is filled, with <code>detail.value</code>. Bubbles.</td></tr>
        <tr><td><code>sui-otp-connected</code></td><td>Slots share one inset surface with no gap.</td></tr>
        <tr><td><code>sui-otp-separator</code></td><td>Dash between groups; add <code>sui-otp-separator-dot</code> for a dot.</td></tr>
        <tr><td><code>sui-otp-sm</code> / <code>sui-otp-lg</code></td><td>Smaller or larger slots.</td></tr>
        <tr><td><code>sui-otp-error</code></td><td>Error styling for an invalid code.</td></tr>
      </tbody>
    </table>
  </div>
</div>
