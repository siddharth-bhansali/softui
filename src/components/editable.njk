<!-- With Events -->
<div class="pg-section" id="section-4">
  <h3 class="pg-section-title">With Events</h3>
  <p class="pg-section-desc">Listen for <code>sui-editable-save</code> and <code>sui-editable-cancel</code> events.</p>
  <div class="pg-section-row" style="gap:12px;flex-direction:column;align-items:flex-start;">
    <div class="sui-editable" id="demo-editable-event">
      <span class="sui-editable-value">Click me to edit</span>
      <svg class="sui-editable-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
    </div>
    <div id="editable-event-log" style="font-size:12px;color:var(--sui-text-muted);min-height:20px;">Events appear here</div>
  </div>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      var el = document.getElementById('demo-editable-event');
      var log = document.getElementById('editable-event-log');
      if (el && log) {
        el.addEventListener('sui-editable-save', function(e) {
          log.textContent = 'Saved: "' + e.detail.value + '" (was "' + e.detail.previous + '")';
          log.style.color = 'var(--sui-success)';
        });
        el.addEventListener('sui-editable-cancel', function() {
          log.textContent = 'Edit cancelled';
          log.style.color = 'var(--sui-text-muted)';
        });
      }
    });
  </script>
  <div class="pg-code-wrap">
    <button class="pg-code-toggle" onclick="toggleGalleryCode(this)"><span class="chevron">&#9654;</span> Show Code</button>
    <div class="pg-code-block"><button class="pg-code-copy" onclick="copyPgCode(this)">Copy</button><pre>&lt;div class="sui-editable" id="myEditable"&gt;
  &lt;span class="sui-editable-value"&gt;Click me to edit&lt;/span&gt;
  &lt;svg class="sui-editable-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"&gt;
    &lt;path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/&gt;
    &lt;path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/&gt;
  &lt;/svg&gt;
&lt;/div&gt;

&lt;script&gt;
  document.getElementById('myEditable')
    .addEventListener('sui-editable-save', function(e) {
      console.log('Saved:', e.detail.value);
      console.log('Previous:', e.detail.previous);
    });

  document.getElementById('myEditable')
    .addEventListener('sui-editable-cancel', function() {
      console.log('Edit cancelled');
    });
&lt;/script&gt;</pre></div>
  </div>
</div>

<!-- Reference -->
<div class="pg-section" id="section-5">
  <h3 class="pg-section-title">Reference</h3>
  <div class="docs-table-wrap">
    <table class="sui-table sui-table-compact">
      <thead>
        <tr><th scope="col" style="width:40%;">Key / Event</th><th scope="col">Description</th></tr>
      </thead>
      <tbody>
        <tr><td><kbd class="sui-kbd-inline">Enter</kbd>, <kbd class="sui-kbd-inline">Space</kbd>, <kbd class="sui-kbd-inline">F2</kbd></td><td>Start editing (the text is a focusable button).</td></tr>
        <tr><td><kbd class="sui-kbd-inline">Enter</kbd> / <kbd class="sui-kbd-inline">Esc</kbd></td><td>Save / cancel; focus returns to the text.</td></tr>
        <tr><td><code>sui-editable-save</code></td><td>Fires on save with <code>detail.value</code> and <code>detail.previous</code>; bubbles.</td></tr>
        <tr><td><code>sui-editable-cancel</code></td><td>Fires on cancel; bubbles.</td></tr>
        <tr><td><code>editable:save</code>, <code>editable:cancel</code></td><td>Older event names; still fire.</td></tr>
      </tbody>
    </table>
  </div>
