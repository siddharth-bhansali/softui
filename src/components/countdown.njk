<!-- Reference -->
<div class="pg-section" id="section-7">
  <h3 class="pg-section-title">Reference</h3>
  <div class="docs-table-wrap">
    <table class="sui-table sui-table-compact">
      <thead>
        <tr><th scope="col" style="width:40%;">Attribute / Event</th><th scope="col">Description</th></tr>
      </thead>
      <tbody>
        <tr><td><code>data-date</code></td><td>ISO 8601 date/time (<code>2028-12-31T00:00:00</code>) or relative <code>+&lt;n&gt;&lt;y|d|h|m|s&gt;</code>, e.g. <code>+2y5d</code>, <code>+6h 30m</code>.</td></tr>
        <tr><td><code>data-years</code>, <code>data-days</code>, <code>data-hours</code>, <code>data-minutes</code>, <code>data-seconds</code></td><td>Value elements the timer fills. Each is optional, but an omitted larger unit is dropped, not carried into the next one.</td></tr>
        <tr><td><code>data-countdown-invalid</code></td><td>Added for an invalid date: units show <code>--</code> and a console warning is logged.</td></tr>
        <tr><td><code>sui-countdown-end</code></td><td>Fires (and bubbles) when the timer reaches zero; never for an invalid date. <code>countdown:end</code> also fires.</td></tr>
      </tbody>
    </table>
  </div>
</div>
