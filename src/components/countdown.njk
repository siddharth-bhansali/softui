  &lt;/div&gt;
  &lt;span class="sui-countdown-separator"&gt;:&lt;/span&gt;
  &lt;div class="sui-countdown-unit"&gt;
    &lt;div class="sui-countdown-value" data-hours&gt;00&lt;/div&gt;
