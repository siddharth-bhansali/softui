<!-- Reference -->
<div class="pg-section" id="section-7">
  <h3 class="pg-section-title">Reference</h3>
  <div class="docs-table-wrap">
    <table class="sui-table sui-table-compact">
      <thead>
        <tr><th scope="col" style="width:40%;">Attribute</th><th scope="col">Description</th></tr>
      </thead>
      <tbody>
        <tr><td><code>data-reserve</code></td><td>Sizes to the longest phrase so the text after it never shifts.</td></tr>
        <tr><td>Initial text</td><td>Text already inside the element (e.g. server-rendered) shows first, then is typed over.</td></tr>
        <tr><td><code>data-sr-text</code></td><td>What screen readers hear (default: all phrases once).</td></tr>
        <tr><td>Reduced motion</td><td>Static text: the first phrase with <code>data-loop</code>, the last without.</td></tr>
      </tbody>
    </table>
  </div>
</div>
