<!-- Reference -->
<div class="pg-section" id="section-11">
  <h3 class="pg-section-title">Reference</h3>
  <div class="docs-table-wrap">
    <table class="sui-table sui-table-compact">
      <thead>
        <tr><th scope="col" style="width:40%;">Class</th><th scope="col">Description</th></tr>
      </thead>
      <tbody>
        <tr><td><code>sui-hero-start</code></td><td>Aligns content to the inline start (right in RTL). Use it instead of <code>sui-text-left</code>.</td></tr>
        <tr><td><code>sui-hero-split</code></td><td>Text and media side by side from 992px; stacked, text first, below. Columns follow the writing direction (mirrored in RTL).</td></tr>
        <tr><td><code>sui-hero-content</code></td><td>Required wrapper for the title, subtitle and actions in a split hero.</td></tr>
        <tr><td><code>sui-hero-media</code></td><td>Holds an <code>&lt;img&gt;</code> or <code>&lt;video&gt;</code>, sized to the column and rounded. Inline SVGs need a <code>viewBox</code>.</td></tr>
        <tr><td><code>sui-hero-media-start</code></td><td>Puts the media first on wide screens.</td></tr>
      </tbody>
    </table>
  </div>
