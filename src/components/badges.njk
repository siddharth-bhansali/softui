<!-- Reference -->
<div class="pg-section" id="section-7">
  <h3 class="pg-section-title">Reference</h3>
  <div class="docs-table-wrap">
    <table class="sui-table sui-table-compact">
      <thead>
        <tr><th scope="col" style="width:40%;">Class / Token</th><th scope="col">Description</th></tr>
      </thead>
      <tbody>
        <tr><td><code>sui-badge</code></td><td>Base badge. Neutral without a colour class.</td></tr>
        <tr><td><code>sui-badge-primary</code>, <code>-success</code>, <code>-danger</code>, <code>-warning</code>, <code>-info</code></td><td>Badge colour.</td></tr>
        <tr><td><code>sui-badge-outline</code></td><td>Border and coloured text instead of a fill.</td></tr>
        <tr><td><code>sui-badge-pill</code></td><td>Fully rounded, for counts.</td></tr>
        <tr><td><code>sui-badge-sm</code>, <code>sui-badge-lg</code></td><td>Small and large badges.</td></tr>
        <tr><td><code>sui-badge-positioned</code></td><td>Wrapper that pins its badge to the top end corner of the element inside.</td></tr>
        <tr><td><code>sui-badge-dot</code></td><td>Empty dot. Give it <code>role="img"</code> and an <code>aria-label</code>.</td></tr>
        <tr><td><code>sui-status</code></td><td>Inline wrapper for a status dot and its visible label. A dot without a label needs <code>role="img"</code> and an <code>aria-label</code>.</td></tr>
        <tr><td><code>sui-status-dot-primary</code>, <code>-success</code>, <code>-warning</code>, <code>-danger</code>, <code>-info</code></td><td>Dot colour. Without one the dot is neutral.</td></tr>
        <tr><td><code>sui-status-dot-pulse</code></td><td>Live ping. Hidden when the user prefers reduced motion.</td></tr>
        <tr><td><code>sui-status-dot-sm</code>, <code>sui-status-dot-lg</code></td><td>Small and large dots.</td></tr>
        <tr><td><code>--sui-status-color</code>, <code>--sui-status-size</code></td><td>Custom colour and size, set on the dot or any ancestor.</td></tr>
      </tbody>
    </table>
  </div>
</div>
